__pycache__/
*.pyc
.claude/settings.local.json
today_input.json
Pool_Log.backup-*.xlsx
_site/
~$*.xlsx
# Phone video originals: large (~40MB). Transcode to a small dated .mp4 with
# ffmpeg before committing (the .mp4 is what the site serves); keep .MOV local only.
*.MOV
# ...and camera-original .MP4s (newer iPhones record .MP4, not .MOV). Only the
# dated, web-ready transcodes (YYYY-MM-DD_vN.mp4) belong in the repo.
photos/IMG_*.MP4
photos/IMG_*.mp4
*.mov

# iCloud dump of raw concert originals (~100MB). The web-ready, re-encoded copies
# live in concert/ and ARE committed; these camera originals stay local only.
icloud/
